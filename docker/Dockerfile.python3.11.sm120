FROM nvidia/cuda:12.8.0-cudnn-devel-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive

SHELL ["/bin/bash", "-c"]

WORKDIR /FastVideo

RUN apt-get update && apt-get install -y --no-install-recommends \
    wget \
    git \
    ca-certificates \
    openssh-server \
    zsh \
    vim \
    curl \
    gcc-11 \
    g++-11 \
    clang-11 \
    && rm -rf /var/lib/apt/lists/*

# Set up C++20 compilers for ThunderKittens
RUN update-alternatives --install /usr/bin/gcc gcc /usr/bin/gcc-11 100 --slave /usr/bin/g++ g++ /usr/bin/g++-11

# Set CUDA environment variables
ENV CUDA_HOME=/usr/local/cuda-12.8
ENV PATH=${CUDA_HOME}/bin:${PATH}
ENV LD_LIBRARY_PATH=${CUDA_HOME}/lib64:$LD_LIBRARY_PATH

# Install uv and source its environment
RUN curl -LsSf https://astral.sh/uv/install.sh | sh && \
    echo 'source $HOME/.local/bin/env' >> /root/.bashrc

# Copy just the pyproject.toml first to leverage Docker cache
COPY pyproject.toml ./

# Create a dummy README to satisfy the installation
RUN echo "# Placeholder" > README.md

# =======================
# 🔥 关键修改：锁 torch=2.8 + 禁止依赖覆盖
# =======================
RUN source $HOME/.local/bin/env && \
    uv venv --python 3.11 --seed /opt/venv && \
    source /opt/venv/bin/activate && \
    uv pip install --no-cache-dir --upgrade pip && \
    uv pip install --no-cache-dir \
        torch==2.8.0 torchvision torchaudio \
        --index-url https://download.pytorch.org/whl/cu128 && \
    uv pip install --no-cache-dir .[dev] --no-deps

# =======================
# 🔥 关键修改：安装你自己的 FA wheel（SM120）
# =======================
COPY wheels/flash_attn-2.7.4.post1+torch2.8.cu128.arch120-cp311-cp311-linux_x86_64.whl /tmp/

RUN source $HOME/.local/bin/env && \
    source /opt/venv/bin/activate && \
    uv pip install --no-cache-dir /tmp/flash_attn-2.7.4.post1+torch2.8.cu128.arch120-cp311-cp311-linux_x86_64.whl

# Copy rest of project
COPY . .

# =======================
# 🔥 关键修改：editable 安装禁止依赖
# =======================
RUN source $HOME/.local/bin/env && \
    source /opt/venv/bin/activate && \
    uv pip install --no-cache-dir -e .[dev] --no-deps && \
    git config --unset-all http.https://github.com/.extraheader || true && \
    echo 'source /opt/venv/bin/activate' >> /root/.bashrc && \
    echo 'if [ -n "$ZSH_VERSION" ] && [ -f ~/.zshrc ]; then . ~/.zshrc; elif [ -f ~/.bashrc ]; then . ~/.bashrc; fi' > /root/.profile

# Install FastVideo Unified Kernel
# RUN source $HOME/.local/bin/env && \
#     source /opt/venv/bin/activate && \
#     cd fastvideo-kernel && \
#     git submodule update --init --recursive && \
#     ./build.sh

EXPOSE 22